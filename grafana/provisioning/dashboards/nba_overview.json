      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "P8042CABD7873BED6"
                      },
                      "group": "grafana-bigquery-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 0,
                        "location": "",
                        "project": "nba-analytics-dev",
                        "rawQuery": true,
                        "rawSql": "WITH team_stats AS (\n  SELECT \n    t.team_name,\n    AVG(f.points_scored - f.points_allowed) as avg_diff\n  FROM `nba-analytics-dev.MART.fact_game_stats` f\n  JOIN `nba-analytics-dev.MART.dim_game` g ON f.game_key = g.game_key\n  JOIN `nba-analytics-dev.MART.dim_team` t ON f.team_key = t.team_key\n  WHERE g.season IN (${season:singlequote})\n  GROUP BY t.team_name\n),\ntop_bottom_teams AS (\n  (SELECT team_name FROM team_stats ORDER BY avg_diff DESC LIMIT 5)\n  UNION ALL\n  (SELECT team_name FROM team_stats ORDER BY avg_diff ASC LIMIT 5)\n),\nteam_diff AS (\n  SELECT \n    t.team_name,\n    g.game_date,\n    (f.points_scored - f.points_allowed) as point_diff\n  FROM `nba-analytics-dev.MART.fact_game_stats` f\n  JOIN `nba-analytics-dev.MART.dim_game` g ON f.game_key = g.game_key\n  JOIN `nba-analytics-dev.MART.dim_team` t ON f.team_key = t.team_key\n  JOIN top_bottom_teams tb ON t.team_name = tb.team_name\n  WHERE g.season IN (${season:singlequote})\n)\nSELECT \n  CAST(game_date AS TIMESTAMP) as time,\n  team_name as metric,\n  AVG(point_diff) OVER(PARTITION BY team_name ORDER BY game_date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) as rolling_diff\nFROM team_diff\nORDER BY time",
                        "sql": {
                          "columns": [
