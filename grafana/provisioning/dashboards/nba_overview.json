                        "rawSql": "SELECT\n  SUM(CASE WHEN f.team_key = g.home_key AND f.is_win THEN 1 ELSE 0 END) as `Home Wins`,\n  SUM(CASE WHEN f.team_key = g.away_key AND f.is_win THEN 1 ELSE 0 END) as `Away Wins`\nFROM `nba-analytics-dev.MART.fact_game_stats` f\nJOIN `nba-analytics-dev.MART.dim_game` g ON f.game_key = g.game_key\nWHERE g.season IN (${season:singlequote})",
