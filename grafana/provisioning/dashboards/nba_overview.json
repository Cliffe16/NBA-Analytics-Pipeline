                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "location": "",
                        "project": "nba-analytics-dev",
                        "rawQuery": true,
                        "rawSql": "SELECT \n  COALESCE(p.player_name, 'Unknown Player') as Player,\n  ROUND(AVG(f.game_score), 1) AS `Average Game Score`,\n  ROUND(SAFE_DIVIDE(SUM(f.points), 2 * (SUM(f.field_goals_attempted) + 0.44 * SUM(f.free_throws_attempted))), 3) AS `True Shooting %`\nFROM `nba-analytics-dev.MART.fact_player_stats` f\nLEFT JOIN `nba-analytics-dev.MART.dim_player` p ON f.player_key = p.player_key\nJOIN `nba-analytics-dev.MART.dim_game` g ON f.game_key = g.game_key\nWHERE g.season IN (${season:singlequote})\nGROUP BY p.player_id, p.player_name\nHAVING COUNT(*) >= 5\nORDER BY `Average Game Score` DESC\nLIMIT 10",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
