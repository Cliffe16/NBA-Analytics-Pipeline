      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "P8042CABD7873BED6"
                      },
                      "group": "grafana-bigquery-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "location": "",
                        "project": "nba-analytics-dev",
                        "rawQuery": true,
                        "rawSql": "SELECT \n  COALESCE(p.player_name, 'Unknown Player') as Player,\n  ROUND(AVG(CASE WHEN g.is_win THEN f.game_score END), 1) as win_game_score,\n  ROUND(AVG(CASE WHEN NOT g.is_win THEN f.game_score END), 1) as loss_game_score\nFROM `nba-analytics-dev.MART.fact_player_stats` f\nLEFT JOIN `nba-analytics-dev.MART.dim_player` p ON f.player_key = p.player_key\nJOIN `nba-analytics-dev.MART.fact_game_stats` g ON f.game_key = g.game_key AND f.team_key = g.team_key\nJOIN `nba-analytics-dev.MART.dim_game` dg ON f.game_key = dg.game_key\nWHERE dg.season IN (${season:singlequote})\nGROUP BY p.player_id, p.player_name\nORDER BY win_game_score DESC\nLIMIT 10",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
